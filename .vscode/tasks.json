{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build ZenLink",
			"type": "shell",
			"command": "xcodebuild",
			"args": [
				"-project",
				"ZenLink.xcodeproj",
				"-scheme",
				"ZenLink",
				"-configuration",
				"Debug",
				"build"
			],
			"group": "build",
			"problemMatcher": [
				"$gcc"
			],
			"isBackground": false
		}
	]
}